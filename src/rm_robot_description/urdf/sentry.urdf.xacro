<?xml version="1.0" encoding="utf-8"?>
<robot name="sentry" xmlns:xacro="http://ros.org/wiki/xacro">

  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <link name="base_footprint" />

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.5925 0.5925 0.05" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>

  <link name="gimbal_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.1" />
      </geometry>
      <material name="white" />
    </visual>
  </link>

  <link name="livox_frame">
    <visual>
      <geometry>
        <box size="0.1 0.06 0.06" />
      </geometry>
      <material name="black" />
    </visual>
  </link>

  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5707 0 0" />
        <geometry>
          <cylinder radius="0.075" length="0.04" /> </geometry>
        <material name="black" />
      </visual>
    </link>
  </xacro:macro>

  <xacro:wheel_link name="wheel_front_left" />
  <xacro:wheel_link name="wheel_front_right" />
  <xacro:wheel_link name="wheel_back_left" />
  <xacro:wheel_link name="wheel_back_right" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link" />
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_gimbal_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gimbal_link" />
    <origin xyz="0 0 0.406" rpy="0 0 0"/>
  </joint>

  <joint name="gimbal_to_livox_joint" type="fixed">
    <parent link="gimbal_link"/>
    <child link="livox_frame" />
    <origin xyz="0 0.17 -0.101" rpy="0 0.7854 1.5708"/>
  </joint>

  <joint name="joint_wheel_front_left" type="continuous">
    <parent link="base_link" />
    <child link="wheel_front_left" />
    <origin xyz="0.25 0.296 -0.025" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="joint_wheel_front_right" type="continuous">
    <parent link="base_link" />
    <child link="wheel_front_right" />
    <origin xyz="0.25 -0.296 -0.025" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="joint_wheel_back_left" type="continuous">
    <parent link="base_link" />
    <child link="wheel_back_left" />
    <origin xyz="-0.25 0.296 -0.025" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="joint_wheel_back_right" type="continuous">
    <parent link="base_link" />
    <child link="wheel_back_right" />
    <origin xyz="-0.25 -0.296 -0.025" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

</robot>