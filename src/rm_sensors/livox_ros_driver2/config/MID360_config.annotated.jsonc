// 注意：该文件仅供阅读，真正调用的是 src/rm_sensors/livox_ros_driver2/config/MID360_config.jsonc

{
  // 雷达概要信息
  "lidar_summary_info": {
    // 协议类型标识（MID360 配置通常为 8，按官方建议不要修改）
    "lidar_type": 8
  },

  // MID360 设备网络配置
  "MID360": {
    "lidar_net_info": {
      // 雷达侧命令端口（设备固定端口，通常不改）
      "cmd_data_port": 56100,
      // 雷达侧状态推送端口（设备固定端口，通常不改）
      "push_msg_port": 56200,
      // 雷达侧点云数据端口（设备固定端口，通常不改）
      "point_data_port": 56300,
      // 雷达侧 IMU 数据端口（设备固定端口，通常不改）
      "imu_data_port": 56400,
      // 雷达侧日志端口（设备固定端口，通常不改）
      "log_data_port": 56500
    },

    "host_net_info": {
      // 主机用于接收命令应答的 IP（填写本机网卡 IP）
      "cmd_data_ip": "192.168.1.5",
      // 主机命令通道端口（需与系统其他端口不冲突）
      "cmd_data_port": 56101,

      // 主机用于接收状态推送的 IP（填写本机网卡 IP）
      "push_msg_ip": "192.168.1.5",
      // 主机状态推送端口
      "push_msg_port": 56201,

      // 主机用于接收点云数据的 IP（填写本机网卡 IP）
      "point_data_ip": "192.168.1.5",
      // 主机点云数据端口
      "point_data_port": 56301,

      // 主机用于接收 IMU 数据的 IP（填写本机网卡 IP）
      "imu_data_ip": "192.168.1.5",
      // 主机 IMU 数据端口
      "imu_data_port": 56401,

      // 主机用于接收日志的 IP（空字符串通常表示不接收日志）
      "log_data_ip": "",
      // 主机日志端口
      "log_data_port": 56501
    }
  },

  // 要配置的雷达列表（多雷达时可继续追加对象）
  "lidar_configs": [
    {
      // 目标雷达设备 IP
      "ip": "192.168.1.3",

      // 点云数据类型：
      // 1=笛卡尔坐标 32 位；2=笛卡尔坐标 16 位；3=球坐标
      "pcl_data_type": 1,

      // 扫描模式：
      // 0=非重复扫描；1=重复扫描；2=低速重复扫描
      "pattern_mode": 0,

      // 盲区设置（单位 cm；该参数主要用于 HAP，MID360 通常可忽略）
      "blind_spot_set": 80,

      "extrinsic_parameter": {
        // 外参旋转（通常为角度制，单位 deg）
        "roll": 0.0,
        "pitch": 45,
        "yaw": 90,

        // 外参平移（Livox 配置中通常为整数，常见单位 mm）
        "x": -180,
        "y": 0,
        "z": 0
      }
    }
  ]
}
